# Postgres (Cloud SQL in production — region asia-southeast1)
DATABASE_URL="postgresql://eventops:password@localhost:5432/eventops?schema=public"

PORT=8080
WEB_ORIGIN="http://localhost:5173"

# --- Auth (Google Workspace OAuth, ADR-004) ---------------------------------
SESSION_SECRET="change-me-to-a-long-random-string"   # signs the session cookie (SECRET)
ALLOWED_EMAIL_DOMAIN="myatag.com"                     # only this Workspace domain may sign in
# Create an OAuth client (Web) in Google Cloud Console -> Credentials.
# Authorised redirect URI must match OAUTH_REDIRECT_URL exactly.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""                         # SECRET - set in api/.env, never commit
OAUTH_REDIRECT_URL="http://localhost:8080/api/auth/google/callback"
# Dev-login (pick a role without Google) is auto-enabled while OAuth is unset.
# Set to 1 to keep it available even after OAuth is configured (local only).
ENABLE_DEV_LOGIN=""

# --- Google Workspace integration (spike-confirmed; fill once set up) -------
# Service account (member of the Shared Drive). Spike confirmed user ADC is NOT
# viable — Google is deprecating the default-client Drive/Sheets scopes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""        # created in GCP, added to the Shared Drive as Content manager
GOOGLE_SERVICE_ACCOUNT_KEY=""          # JSON key, base64-encoded (SECRET — set in api/.env, never commit)
GOOGLE_SHARED_DRIVE_ID="0AECZvjbndJEEUk9PVA"              # Shared Drive "EventOps OS"
GOOGLE_EVENTS_FOLDER_ID="1zYQv1LqYJXjrVorqMJlc-5oOZFlI_4ma" # "EVENT OPS OS Events" folder inside it
GOOGLE_OPS_GROUP_EMAIL=""              # optional: Google Group granted Content manager

# Per-deliverable template file ids on the Shared Drive (copied + merged on generate).
# Templates are Sheets + Slides (no Docs). Discovered from the Shared Drive:
GOOGLE_TEMPLATE_DECK_ID="160pXA5mWHB13zPjYKReQZ0Lzqke6ei3fUFbtO1S6jz4"       # Slides: "Scavenger Hunt/Amazing Race Slide"
GOOGLE_TEMPLATE_SCORESHEET_ID="1SLan91_0JFrYg5wjCK8R2vNhIOfV6uderIvIftWPzc4" # Sheet: "Operations Event Checklist Template" (has Activity Master tab) — confirm this is the scoresheet
GOOGLE_TEMPLATE_RUNSHEET_ID="1aZU0HC3xXAUDyxklVmN01ccHZo_oOrsASIg4tQ1dboc"   # Sheet: "Event Flow & Roles Template"
GOOGLE_SCORESHEET_TAB="Activity Master" # tab the leaderboard is written to (no named ranges in templates)

# --- Facilitator App integration -------------------------------------------
FACILITATOR_API_BASE=""
FACILITATOR_API_KEY=""
