# Postgres (Cloud SQL in production — region asia-southeast1)
DATABASE_URL="postgresql://eventops:password@localhost:5432/eventops?schema=public"

PORT=8080
WEB_ORIGIN="http://localhost:5173"

# --- Google Workspace integration (spike-confirmed; fill once set up) -------
# Service account (member of the Shared Drive). Spike confirmed user ADC is NOT
# viable — Google is deprecating the default-client Drive/Sheets scopes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_KEY=""          # JSON key, base64-encoded
GOOGLE_SHARED_DRIVE_ID=""              # the Shared Drive to create and move templates into
GOOGLE_EVENTS_FOLDER_ID=""             # the "EVENT OPS OS Events" folder (new event folders are created inside it)
GOOGLE_TEMPLATE_FOLDER_ID="1fvBGdH5kUBmoKAK4vNZImT2N5D-iVi6C"  # master template root ("Operation System Bots")
GOOGLE_OPS_GROUP_EMAIL=""              # Google Group granted Content manager

# Per-deliverable template file ids (copied + merged on generate).
# Your templates are Sheets + Slides (no Docs). Pick the specific files from
# Activity Scoresheets / Activity Event Slides / Activity Event Flow.
GOOGLE_TEMPLATE_DECK_ID=""             # a Google Slides deck (e.g. "Scavenger Hunt/Amazing Race Slide")
GOOGLE_TEMPLATE_SCORESHEET_ID=""       # a Google Sheet scoresheet template
GOOGLE_TEMPLATE_RUNSHEET_ID=""         # a Google Sheet run-sheet / event-flow template
GOOGLE_SCORESHEET_TAB="Activity Master" # tab the leaderboard is written to (no named ranges in templates)

# --- Facilitator App integration -------------------------------------------
FACILITATOR_API_BASE=""
FACILITATOR_API_KEY=""
